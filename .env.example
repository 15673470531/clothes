APP_NAME=clothes
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8090

APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=zh_CN

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# 本地开发连 docker-compose.override.yml 起的 mysql 容器
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=clothes
DB_USERNAME=clothes
DB_PASSWORD=clothes_pass

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

#--------------------------------------------------------------------------
# 微信小程序（每个项目必须换成自己的小程序账号，禁止沿用其他项目的值）
#--------------------------------------------------------------------------
WECHAT_APPID=
WECHAT_APPSECRET=
# 订阅消息下发环境：trial=体验版 / developer=开发版 / formal=正式版
WECHAT_MSG_STATE=formal

#--------------------------------------------------------------------------
# 阿里云 OSS（图片存储，2026-09 二期第一步；方案 A：小程序 → 后端 → OSS）
# 不填 OSS_ACCESS_KEY_ID 时图片自动落本地 public 盘（storage/app/public），本地开发不用密钥；
# 线上填上这几个就自动切 OSS，代码不用改。endpoint 写域名不带协议。
#--------------------------------------------------------------------------
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=
OSS_DOMAIN=
OSS_SSL=true
