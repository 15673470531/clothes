APP_NAME=clothes
APP_ENV=local
# 允许小程序用 dev_ 开头的 code 跳过微信登录（本机开发用）
# ⚠️ 线上必须 false 或留空：这个模式按 code 的 md5 建 openid，而真机 code 每次都变，
#    线上开着会「每登一次新建一个用户」（2026-09 踩过）
ALLOW_DEV_LOGIN=true
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8090

APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=zh_CN

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# 本地开发连 docker-compose.override.yml 起的 mysql 容器
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=clothes
DB_USERNAME=clothes
DB_PASSWORD=clothes_pass

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# AI 试穿（2026-09 · 详见 docs/AI试穿.md）
DASHSCOPE_API_KEY=
TRYON_ENABLED=false
TRYON_MODEL_IMAGE=
TRYON_MEMBER_ONLY=false
TRYON_DAILY_LIMIT=10

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

#--------------------------------------------------------------------------
# 微信小程序（每个项目必须换成自己的小程序账号，禁止沿用其他项目的值）
#--------------------------------------------------------------------------
WECHAT_APPID=
WECHAT_APPSECRET=
# 订阅消息下发环境：trial=体验版 / developer=开发版 / formal=正式版
WECHAT_MSG_STATE=formal

#--------------------------------------------------------------------------
# 阿里云 OSS（图片存储，2026-09 二期第一步；方案 A：小程序 → 后端 → OSS）
# 不填 OSS_ACCESS_KEY_ID 时图片自动落本地 public 盘（storage/app/public），本地开发不用密钥；
# 线上填上这几个就自动切 OSS，代码不用改。endpoint 写域名不带协议。
#--------------------------------------------------------------------------
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=
OSS_DOMAIN=
OSS_SSL=true

#--------------------------------------------------------------------------
# 衣架额度（2026-09）：「我的」页顶部衣架卡的数字全部从这里下发
# 改数字只改这里（或 Filament 里改某个用户的余额），**不用发小程序版本**
# 免费进货量：新用户送 QUOTA_ITEM 个，每天最多挂 QUOTA_DAILY 个（每天重置）
# 赚衣架：每日签到送 QUOTA_REWARD_CHECKIN 个，分享好友送 QUOTA_REWARD_SHARE 个，
#         每种每天最多领 *_DAILY 次。奖励加到总额上、不受免费上限约束。
#--------------------------------------------------------------------------
QUOTA_ITEM=100
QUOTA_DAILY=100
QUOTA_REWARD_CHECKIN=2
QUOTA_REWARD_SHARE=10
QUOTA_REWARD_CHECKIN_DAILY=1
QUOTA_REWARD_SHARE_DAILY=1
# 新用户每月免费领取多少（按自然月 1 次，**要点一下领取**才到账；0 = 关掉这一行）
QUOTA_REWARD_NEWCOMER=50
# 每月系统免费赠送（老口径：按月自动到账、不用点。已被上面的"新用户每月免费领取"取代，0 = 关闭）
QUOTA_REWARD_MONTHLY=0
